@model IEnumerable<CMS_ASSIGNMENT.ViewModels.ClaimListViewModel>
@{
    ViewData["Title"] = "Coordinator Dashboard";
    var user = ViewBag.User as CMS_ASSIGNMENT.Models.ApplicationUser;
    var pending = ViewBag.PendingNotification;
}

<div class="dashboard-header">
    <h2>Welcome, @user?.FirstName!</h2>
    <div>
        <span class="text-muted">@user?.Role.ToString() Dashboard</span>
    </div>
</div>

@if (pending != null)
{
    <div class="notification-strip" data-total="@pending.Total" data-flagged="@pending.Flagged" data-blocking="@pending.Blocking">
        <div class="card" style="margin-bottom: 25px;">
            <div class="notification-grid">
                <div>
                    <small class="text-muted">Pending Claims</small>
                    <div class="metric">@pending.Total</div>
                </div>
                <div>
                    <small class="text-muted">Flagged For Review</small>
                    <div class="metric text-warning">@pending.Flagged</div>
                </div>
                <div>
                    <small class="text-muted">Blocking Issues</small>
                    <div class="metric text-danger">@pending.Blocking</div>
                </div>
            </div>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h3 style="margin-bottom: 30px; color: var(--peach); font-size: 28px;">Claims for Review</h3>
@if (!Model.Any())
{
    <div class="alert alert-info">
        No pending claims for review.
    </div>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Claim ID</th>
                <th>Lecturer Name</th>
                <th>Date Submitted</th>
                <th>Hours</th>
                <th>Amount (ZAR)</th>
                <th>Status</th>
                <th>Flags</th>
                <th>Document</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var claim in Model)
            {
                <tr>
                    <td>@claim.Id</td>
                    <td>@claim.LecturerName</td>
                    <td>@claim.SubmittedDate.ToString("yyyy-MM-dd")</td>
                    <td>@claim.HoursWorked</td>
                    <td>R @claim.TotalAmount.ToString("N2")</td>
                    <td>
                        <span class="badge @GetStatusBadgeClass(claim.Status)">@claim.Status</span>
                    </td>
                    <td class="flag-column">
                        @if (claim.HasBlockingViolations)
                        {
                            <span class="badge bg-danger">Blocked</span>
                        }
                        else if (claim.IsFlaggedForReview)
                        {
                            <span class="badge bg-warning text-dark">Review</span>
                        }

                        @if (!string.IsNullOrWhiteSpace(claim.FlaggedReasons))
                        {
                            <div class="flag-reasons">@claim.FlaggedReasons</div>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(claim.DocumentFileName))
                        {
                            <a href="@Url.Action("DownloadDocument", new { id = claim.Id })" class="btn btn-sm btn-outline-primary">
                                Download
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">No document</span>
                        }
                    </td>
                    <td>
                        <div class="action-buttons">
                            <button class="btn btn-sm" onclick="viewClaim(@claim.Id)">View</button>
                            <form asp-action="ApproveClaim" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@claim.Id" />
                                <button type="submit" class="btn btn-sm btn-success" @(claim.HasBlockingViolations ? "disabled" : string.Empty) title="@(claim.HasBlockingViolations ? claim.FlaggedReasons : null)">
                                    <span>Approve</span>
                                </button>
                            </form>
                            <form asp-action="RejectClaim" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@claim.Id" />
                                <button type="submit" class="btn btn-sm btn-danger"><span>Reject</span></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        (function () {
            const notificationStrip = document.querySelector('.notification-strip');
            if (notificationStrip) {
                const total = parseInt(notificationStrip.dataset.total || '0', 10);
                const flagged = parseInt(notificationStrip.dataset.flagged || '0', 10);
                const blocking = parseInt(notificationStrip.dataset.blocking || '0', 10);

                if (total > 0) {
                    const toast = document.createElement('div');
                    toast.className = 'toast pending-toast show';
                    toast.innerHTML = `
                        <div class="toast-header">
                            <strong class="me-auto">Pending Approvals</strong>
                            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                        <div class="toast-body">
                            <div><strong>${total}</strong> claim${total === 1 ? '' : 's'} require your attention.</div>
                            ${flagged > 0 ? `<div class="text-warning mt-2">${flagged} flagged for review.</div>` : ''}
                            ${blocking > 0 ? `<div class="text-danger mt-2">${blocking} contain blocking issues.</div>` : ''}
                        </div>`;

                    document.body.appendChild(toast);

                    toast.querySelector('.btn-close')?.addEventListener('click', () => {
                        toast.remove();
                    });

                    setTimeout(() => toast.remove(), 10000);
                }
            }
        })();

        function viewClaim(claimId) {
            alert('View details for claim ID: ' + claimId);
            // In a real application, you would show a modal with claim details
        }
    </script>
}

@functions {
    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning",
            "ApprovedByCoordinator" => "bg-info",
            "ApprovedByManager" => "bg-success",
            "RejectedByCoordinator" or "RejectedByManager" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
