@page
@model CMS_ASSIGNMENT.Areas.HR.Pages.Lecturers.IndexModel
@{
    ViewData["Title"] = "Lecturer Profiles";
}

<div class="dashboard-header">
    <h2>Lecturer Directory</h2>
    <div>
        <a asp-page="/Index" class="btn btn-outline-primary"><span>Back to HR Dashboard</span></a>
    </div>
</div>

<form method="get" class="filter-form" style="margin-top: 25px; display: flex; flex-wrap: wrap; gap: 15px; align-items: flex-end;">
    <div class="form-group" style="flex: 1 1 250px;">
        <label for="searchTerm">Search</label>
        <input id="searchTerm" asp-for="SearchTerm" class="form-control" placeholder="Search by name or email" />
    </div>
    <div class="form-group" style="width: 220px;">
        <label for="filter">Filter</label>
        <select id="filter" asp-for="Filter" class="form-control">
            <option value="all">All Lecturers</option>
            <option value="withClaims">With Claims</option>
            <option value="withoutClaims">Without Claims</option>
            <option value="flagged">Flagged Claims</option>
        </select>
    </div>
    <div class="form-group" style="width: 140px;">
        <button type="submit" class="btn btn-primary" style="width: 100%;"><span>Apply</span></button>
    </div>
    <div class="form-group" style="width: 140px;">
        <a class="btn btn-outline-secondary" asp-page="./Index"><span>Reset</span></a>
    </div>
    <div class="form-group" style="margin-left: auto;">
        <a class="btn btn-success" asp-page="./Create"><span>New Lecturer</span></a>
    </div>
</form>

@if (!Model.Lecturers.Any())
{
    <div class="alert alert-info" style="margin-top: 30px;">
        No lecturers found matching the current filters.
    </div>
}
else
{
    <div class="table-responsive" style="margin-top: 30px;">
        <table>
            <thead>
                <tr>
                    <th>Lecturer</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Total Claims</th>
                    <th>Approved</th>
                    <th>Approved Amount (ZAR)</th>
                    <th>Flagged</th>
                    <th>Last Submitted</th>
                    <th style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lecturer in Model.Lecturers)
                {
                    <tr>
                        <td><strong>@lecturer.FullName</strong></td>
                        <td>@lecturer.Email</td>
                        <td>@(string.IsNullOrWhiteSpace(lecturer.PhoneNumber) ? "—" : lecturer.PhoneNumber)</td>
                        <td>@lecturer.TotalClaims</td>
                        <td>@lecturer.ApprovedClaims</td>
                        <td>R @lecturer.TotalApprovedAmount.ToString("N2")</td>
                        <td>
                            @if (lecturer.FlaggedClaims > 0)
                            {
                                <span class="badge bg-warning text-dark">@lecturer.FlaggedClaims</span>
                            }
                            else
                            {
                                <span class="badge bg-success">0</span>
                            }
                        </td>
                        <td>@(lecturer.LastSubmitted?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>
                            <div class="action-buttons">
                                <a class="btn btn-sm" asp-page="./Details" asp-route-id="@lecturer.Id">View</a>
                                <a class="btn btn-sm btn-outline-primary" asp-page="./Edit" asp-route-id="@lecturer.Id"><span>Edit</span></a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@lecturer.Id" style="display:inline;" onsubmit="return confirm('Delete lecturer @lecturer.FullName? This action cannot be undone.');">
                                    <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                    <input type="hidden" name="Filter" value="@Model.Filter" />
                                    <button type="submit" class="btn btn-sm btn-danger"><span>Delete</span></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
